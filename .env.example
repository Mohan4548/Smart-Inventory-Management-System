# Environment Variable Template - Smart Inventory & Billing Management System
# Copy this file to .env and replace placeholder values with your local configuration.

# Spring Boot Server Port
PORT=8080

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_inventory_db
DB_USERNAME=root
DB_PASSWORD=root

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:8080/api
